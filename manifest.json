{
  "name": "Editor de Imagenes JPB",
  "short_name": "Editor JPB",
  "description": "Editor de imágenes tipo Paint para Android y Windows. Pincel, figuras, texto, filtros y más.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#4f46e5",
  "theme_color": "#4f46e5",
  "lang": "es",
  "dir": "ltr",
  "categories": ["graphics", "productivity", "photo"],
  "icons": [
    { "src": "icons/icon-64.png",  "sizes": "64x64",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/bmp", "image/gif"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/png":  [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/bmp":  [".bmp"],
        "image/gif":  [".gif"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Nuevo lienzo",
      "short_name": "Nuevo",
      "url": "./index.html?action=new"
    },
    {
      "name": "Abrir imagen",
      "short_name": "Abrir",
      "url": "./index.html?action=open"
    }
  ]
}